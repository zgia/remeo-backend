{
    "name": "zgia/meningioma",
    "type": "project",
    "description": "脑膜瘤数据库 API",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.42",
        "mews/captcha": "^3.5",
        "overtrue/laravel-query-logger": "^6.0",
        "phpoffice/phpspreadsheet": "^5.11",
        "phpoffice/phpword": "^1.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.94",
        "kitloong/laravel-migrations-generator": "^7.1",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Function/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
